package com.mycompany.equipomaratonpag418;

import javax.swing.JOptionPane;

public class EquipoMaraton {
    public String nombreEquipo;
    public String universidad;
    public String lenguajeProgramacion;
    public int tamañoEquipo;
    public int numeroProgramadores = 0;

    EquipoMaraton(String nombreEquipo, String universidad, String lenguajeProgramacion, int tamañoEquipo) {
        this.nombreEquipo = nombreEquipo;
        this.universidad = universidad;
        this.lenguajeProgramacion = lenguajeProgramacion;
        this.tamañoEquipo = tamañoEquipo;
    }

    public void validarNombre(String nombre) {
        try {
            if (nombre.length() >= 20) {
                throw new Exception();
            }
            for (int i = 0; i < nombre.length(); i++) {
                if (Character.isDigit(nombre.charAt(i))) {
                    throw new Exception();
                }
            }
        } catch (Exception e) {
            JOptionPane.showMessageDialog(null,"El nombre no puede contener números ni tener 20 caracteres o más","Error",JOptionPane.ERROR_MESSAGE);
        }
    }

    public void agregarProgramador(String nombre, String apellido) {
        try {
            if (numeroProgramadores >= tamañoEquipo) {
                throw new Exception();
            }
            validarNombre(nombre);
            validarNombre(apellido);
            numeroProgramadores++;
            JOptionPane.showMessageDialog(null,"Programador agregado correctamente","Información",JOptionPane.INFORMATION_MESSAGE);
        } catch (Exception e) {
            JOptionPane.showMessageDialog(null,"El equipo ya está completo","Error",JOptionPane.ERROR_MESSAGE);
        }
    }

    public void mostrarDatos() {
        JOptionPane.showMessageDialog(null,"Equipo: " + nombreEquipo +"\nUniversidad: " + universidad +"\nLenguaje: " + lenguajeProgramacion +"\nProgramadores registrados: " + numeroProgramadores,"Datos del equipo",JOptionPane.INFORMATION_MESSAGE);
    }
}

