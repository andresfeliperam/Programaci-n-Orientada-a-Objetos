Ejercicio #4 

A la mamá de Juan le preguntan su edad, y contesta: tengo 3 hijos, Juan tiene 9 años. Alberto tiene 2/3 de la edad de Juan, Ana tiene 4/3 de la edad de Juan y mi edad es la suma de las tres. 

public class Edades { 

public static double calcular_alber(double juan){ 

    	double alber = 2*juan/3; 

    	return alber; 

    	} 

public static double calcular_ana(double juan){ 

    	double ana = 4*juan/3; 

    	return ana; 

    	} 

public static double calcular_mama(double juan, double alber, double ana){ 

    	double mama = juan+ana+alber; 

    	return mama; 

    	} 

} 

 

public class Ejercicio4 { 

public static void main(String[] args) { 

        	double juan = 9; 

        	double alber = Edades.calcular_alber(juan); 

        	double ana = Edades.calcular_ana(juan); 

        	double mama = Edades.calcular_mama(juan, alber, ana); 

System.out.println("Las edades son: Juan="+juan+", Alber="+alber+", Ana="+ana+", Mamá="+mama); 

    	} 

} 

 

Ejercicio #5 

Hacer un seguimiento (prueba de escritorio) del siguiente grupo de instrucciones. INICIO, SUMA = 0, X=20, SUMA = SUMA + X, Y= 40, X=X+Y ** 2, SUMA = SUMA + X/Y, ESCRIBA: "EL VALOR DE LA SUMA ES:" SUMA, FIN_INICIO. 

public class Calculos { 

public static double calcular_suma1(double suma, double x){ 

   	return suma + x; 

} 

public static double calcular_x(double x, double y){ 

    	return x + Math.pow(y, 2); 

}     

 	public static double calcular_suma2(double x, double y, double suma){ 

    	return suma + x/y; 

}   

 } 

 

public class Ejercicio5 { 

public static void main(String[] args) { 

        	double suma, x, y; 

        	suma = 0; 

        	x = 20; 

        	y = 40;      

        	suma = Calculos.calcular_suma1(suma, x);        

        	x = Calculos.calcular_x(x, y); 

