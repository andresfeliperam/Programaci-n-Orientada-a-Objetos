Ejercicio #17 

Dado el radio de un círculo. Haga un algoritmo que obtenga el área del círculo y la longitud de la circunferencia. 

 

public class Calculos { 

public static double calcular_longitud_circunferencia(double radio){ return 2 * Math.PI * radio; } 

public static double calcular_area_circulo(double radio){ return Math.PI * Math.pow(radio, 2); } 

} 

 

public class Ejercicio17 { 

public static void main(String[] args) { 

        	double radio = 3; 

        	double longitud_circuferencia = Calculos.calcular_longitud_circunferencia(radio); 

        	double area_circulo = Calculos.calcular_area_circulo(radio); 

        	System.out.println("Longitud circunferencia: "+longitud_circuferencia); 

        	System.out.println("Área círculo: "+area_circulo); 

 	} 

} 

 

 
